# Claude API key. Without it the agent falls back to deterministic templates
# (all safety + negotiation rules still apply, the copy is just less natural).
ANTHROPIC_API_KEY=

# claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
ANTHROPIC_MODEL=claude-sonnet-5

# mock | facebook
MARKETPLACE_MODE=mock

# Set to 1 to run the real Facebook browser headless (NOT recommended: you must
# be able to log in and solve any verification challenge yourself).
HEADLESS=0

# Mock marketplace server port
MOCK_PORT=4010
